# Copy to .env (git-ignored) and adjust. Read by docker compose.
PORT=8080
# Watch a remote repo instead of the mounted local one:
# GIT_REPO_URL=https://github.com/you/vyroclipper.git
GIT_BRANCH=main
GIT_POLL_SECONDS=30
# Enables POST /api/hooks/git for instant deploys on push
WEBHOOK_SECRET=
# Protects /api/proxy and /api/media/* (enter the same value in Studio → Settings)
API_TOKEN=
