{
  "name": "vyroclipper",
  "version": "1.0.0",
  "private": true,
  "description": "AI video clipper for Vyro clipping campaigns: viral moment detection, auto-reframe, animated captions, campaign-rule compliance. Runs 100% client-side in the browser (web app + Chrome extension).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --mode web",
    "build": "npm run build:web && npm run build:ext",
    "build:web": "vite build --mode web",
    "build:ext": "node scripts/build-extension.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/index.ts",
    "serve": "node server/supervisor.ts",
    "package:ext": "node scripts/package-extension.ts",
    "e2e": "node tests/e2e/run.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@mediapipe/tasks-vision": "^1.1.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "mediabunny": "^1.62.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0-beta.1"
  }
}
